# Learn more https://docs.github.com/en/get-started/getting-started-with-git/ignoring-files

# dependencies
node_modules/

# Expo
.expo/
dist/
web-build/
expo-env.d.ts

# Native
.kotlin/
*.orig.*
*.jks
*.p8
*.p12
*.key
*.mobileprovision

# Metro
.metro-health-check*

# debug
npm-debug.*
yarn-debug.*
yarn-error.*

# macOS
.DS_Store
*.pem

# local env files
.env
.env*.local

# typescript
*.tsbuildinfo

# generated native folders
/ios
/android

# Supabase CLI local state — holds the linked project's pooler connection
# string, which has no business in a public repository.
supabase/.temp/

# Python bytecode from scripts/
__pycache__/
*.pyc

# Generated store images — rebuild with scripts/store_screenshots.py
docs/screenshots/store/
docs/screenshots/store-tr/
docs/screenshots/store-de/

# Generated Play graphics — rebuild with scripts/make_store_graphics.py
docs/screenshots/graphics/

docs/screenshots/play-en/
docs/screenshots/play-tr/
docs/screenshots/play-de/
