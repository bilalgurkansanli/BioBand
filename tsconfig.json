{
  "extends": "expo/tsconfig.base",
  "compilerOptions": {
    "strict": true,
    // TypeScript 6 no longer pulls in every @types package by default; the
    // test files need Jest's globals declared.
    "types": ["jest"]
  },
  "exclude": [
    // Deno, not React Native: these run on Supabase's Edge runtime, with its
    // own globals and jsr: imports. Type-checking them against the app's
    // config only produces noise about a platform they never run on.
    "supabase/functions",
    // Agent worktrees are whole copies of the repo.
    ".claude"
  ]
}
