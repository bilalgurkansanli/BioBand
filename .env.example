# Copy this file to .env and fill in your own project's values.
# These are all "public" client-side values — safe to ship in the app binary
# (Supabase access is enforced by Row Level Security, not by hiding this key).

# Supabase project settings -> API
EXPO_PUBLIC_SUPABASE_URL=https://your-project-ref.supabase.co
EXPO_PUBLIC_SUPABASE_ANON_KEY=your-anon-key

# Google Cloud Console -> APIs & Services -> Credentials
# The "Web application" OAuth client ID (NOT the Android one) — required by
# GoogleSignin on Android to mint a Google ID token for Supabase.
EXPO_PUBLIC_GOOGLE_WEB_CLIENT_ID=your-web-client-id.apps.googleusercontent.com
# The "iOS" OAuth client ID — only needed if/when you build for iOS.
EXPO_PUBLIC_GOOGLE_IOS_CLIENT_ID=your-ios-client-id.apps.googleusercontent.com
